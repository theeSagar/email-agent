# Copy this file to frontend/.env.local and fill in real values. Never commit .env.local.

# Supabase dashboard -> Project Settings -> API Keys.
# The publishable key is safe to show in the browser (RLS protects the data).
# A legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Where the FastAPI backend runs. Your Railway URL in production.
NEXT_PUBLIC_API_URL=http://localhost:8000

# The only Google account allowed in. Used on the Next.js server only (no NEXT_PUBLIC_
# prefix), so it is never sent to visitors' browsers.
OWNER_EMAIL=you@gmail.com
