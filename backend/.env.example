# Copy this file to backend/.env and fill in real values. Never commit .env.

# The only Google account allowed to use the app.
OWNER_EMAIL=you@gmail.com

# Supabase dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Only for older Supabase projects using the "legacy JWT secret". Leave empty otherwise.
SUPABASE_JWT_SECRET=

# The frontend address allowed to call the API (CORS). Your Vercel URL in production.
FRONTEND_ORIGIN=http://localhost:3000
